# Non-secret production configuration example; copy to an excluded private file.
# Production code runs with AISEO_ENVIRONMENT=production and guarded private routes.
AISEO_PUBLIC_ORIGIN=https://aiseoonline.com
AISEO_API_IMAGE=
AISEO_WEB_IMAGE=
AISEO_DB_PASSWORD=
AISEO_REDIS_PASSWORD=
AISEO_BACKUP_DIR=/var/backups/aiseoonline-production
AISEO_FRESH_INSTALL=false
AISEO_START_TUNNEL=false
AISEO_CLOUDFLARED_IMAGE=
AISEO_CLOUDFLARED_TOKEN=
