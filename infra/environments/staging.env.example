# Non-secret staging configuration example; copy to an excluded private file.
# Keep all variables exported for docker compose interpolation.
AISEO_PUBLIC_ORIGIN=https://staging.aiseoonline.com
AISEO_API_IMAGE=
AISEO_WEB_IMAGE=
AISEO_DB_PASSWORD=
AISEO_REDIS_PASSWORD=
AISEO_BACKUP_DIR=/var/backups/aiseoonline-staging
AISEO_FRESH_INSTALL=false
AISEO_START_TUNNEL=false
# Only when enabling Cloudflare Tunnel after manual hostname configuration:
AISEO_CLOUDFLARED_IMAGE=
AISEO_CLOUDFLARED_TOKEN=
