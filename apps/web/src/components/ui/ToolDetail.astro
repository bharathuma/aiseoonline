---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PublicToolForm from '../PublicToolForm.tsx';
import AiMetaForm from '../AiMetaForm.tsx';
import AdPlaceholder from '../AdPlaceholder.astro';
import { toolBySlug, toolPath } from '../toolCatalog';
import type { ToolPreview } from '../toolCatalog';
import { toolGuides } from '../toolGuides';

interface Props {
  tool: ToolPreview;
}
const { tool } = Astro.props;
const guide = toolGuides[tool.id];
const kind =
  tool.id === 'metadata'
    ? 'meta'
    : (tool.id as
        | 'robots'
        | 'sitemap'
        | 'redirects'
        | 'canonical'
        | 'schema'
        | 'headings'
        | 'links'
        | 'social');
const related = guide.related
  .map((slug) => toolBySlug(slug))
  .filter((value): value is ToolPreview => value !== undefined && value.status === 'available');
const origin = 'https://aiseoonline.com';
const url = new URL(toolPath(tool), origin).toString();
const structured = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Tools', item: origin + '/tools/' },
      { '@type': 'ListItem', position: 2, name: tool.name, item: url },
    ],
  },
  ...(tool.id !== 'ai-meta'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebApplication',
          name: tool.name,
          description: guide.description,
          url,
          applicationCategory: 'SEO utilities',
          operatingSystem: 'Web browser',
          isAccessibleForFree: true,
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
const ldJson = JSON.stringify(structured).replace(/</g, '\\u003c');
---

<SiteLayout title={guide.title + ' — AISEOOnline'} description={guide.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={ldJson} />
  <section class="section-space bg-white">
    <div class="site-container max-w-4xl">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-600">
        <a class="inline-link" href="/tools/">All tools</a><span class="mx-2" aria-hidden="true"
          >/</span
        ><span aria-current="page">{tool.name}</span>
      </nav>
      <p class="eyebrow mt-12">{tool.category}</p>
      <h1 class="section-title mt-3">{tool.name}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">{guide.intro}</p>
      <div class="mt-9 max-w-2xl">
        <p class="mb-5 text-sm leading-7 text-slate-600">
          {
            tool.id === 'ai-meta'
              ? 'Paste your own content or enter a public URL for editable, evidence-checked drafts. AI output requires human review and may be unavailable without model credentials.'
              : 'Enter one public URL for a bounded check. Results describe observed page evidence; they do not guarantee search engine results.'
          }
        </p>
        {
          tool.id === 'ai-meta' ? (
            <AiMetaForm client:load />
          ) : (
            <PublicToolForm kind={kind} client:load />
          )
        }
      </div>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container max-w-4xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-950">What this tool checks</h2>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2">
        {
          tool.details.map((detail) => (
            <li class="surface-card flex items-start gap-3">
              <span class="mt-0.5 text-teal-700" aria-hidden="true">
                ✓
              </span>
              <span class="text-sm leading-7 text-slate-700">{detail}</span>
            </li>
          ))
        }
      </ul>
      <AdPlaceholder />
      <h2 class="mt-14 text-2xl font-bold tracking-tight text-slate-950">How to use the checker</h2>
      <ol class="mt-6 list-decimal space-y-3 pl-6 leading-8 text-slate-700">
        {guide.steps.map((step) => <li>{step}</li>)}
      </ol>
      <section
        class="mt-12 rounded-xl border border-slate-200 bg-white p-6 sm:p-8"
        aria-labelledby="example-heading"
      >
        <h2 id="example-heading" class="text-2xl font-bold">{guide.example.title}</h2>
        <p class="mt-4 text-sm font-semibold text-slate-700">Example input</p>
        <pre
          class="mt-2 whitespace-pre-wrap break-words rounded-lg bg-slate-100 p-4 text-sm text-slate-800"><code>{guide.example.input}</code></pre>
        <p class="mt-5 text-sm font-semibold text-slate-700">What to notice</p>
        <p class="mt-2 leading-7 text-slate-700">{guide.example.finding}</p>
        <p class="mt-5 text-sm font-semibold text-slate-700">Practical next step</p>
        <p class="mt-2 leading-7 text-slate-700">{guide.example.action}</p>
        <p class="mt-4 text-xs text-slate-600">Illustrative example, not a live test result.</p>
      </section>
      <h2 class="mt-14 text-2xl font-bold">Troubleshooting</h2>
      <div class="mt-6 space-y-7">
        {
          guide.troubleshooting.map((issue) => (
            <div>
              <h3 class="font-semibold text-slate-950">{issue.title}</h3>
              <p class="mt-2 leading-7 text-slate-700">{issue.body}</p>
            </div>
          ))
        }
      </div>
      <h2 class="mt-14 text-2xl font-bold">Limits of this check</h2>
      <p class="mt-4 leading-8 text-slate-700">{guide.limitations}</p>
      <h2 class="mt-14 text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-6 space-y-7">
        {
          guide.faqs.map((faq) => (
            <div>
              <h3 class="font-semibold text-slate-950">{faq.question}</h3>
              <p class="mt-2 leading-7 text-slate-700">{faq.answer}</p>
            </div>
          ))
        }
      </div>
      <nav class="mt-14" aria-label="Related SEO tools">
        <h2 class="text-2xl font-bold">Related checks</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            related.map((item) => (
              <li class="surface-card">
                <a href={toolPath(item)} class="inline-link font-semibold">
                  {item.name} ↗
                </a>
                <p class="mt-2 text-sm leading-7 text-slate-600">{item.summary}</p>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mt-10">
        <a href="/tools/" class="inline-link font-semibold">← Browse all SEO tools</a>
      </div>
    </div>
  </section>
</SiteLayout>
