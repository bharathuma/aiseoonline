---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StatusNotice from './StatusNotice.astro';
import PublicToolForm from '../PublicToolForm.tsx';
import AiMetaForm from '../AiMetaForm.tsx';
import type { ToolPreview } from '../toolCatalog';

interface Props {
  tool: ToolPreview;
}
const { tool } = Astro.props;
const kind =
  tool.id === 'metadata'
    ? 'meta'
    : (tool.id as
        | 'robots'
        | 'sitemap'
        | 'redirects'
        | 'canonical'
        | 'schema'
        | 'headings'
        | 'links'
        | 'social');
---

<SiteLayout
  title={(tool.status === 'available' ? 'Free ' : '') + tool.name + ' — AISEOOnline'}
  description={tool.summary +
    (tool.status === 'available'
      ? ' Run a free single-URL check with evidence and clear limitations.'
      : ' Tool details and availability.')}
  noindex={tool.status === 'planned'}
>
  <section class="section-space bg-white">
    <div class="site-container max-w-4xl">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-600">
        <a class="inline-link" href="/tools/">All tools</a><span class="mx-2" aria-hidden="true"
          >/</span
        ><span aria-current="page">{tool.name}</span>
      </nav>
      <p class="eyebrow mt-12">{tool.category}</p>
      <h1 class="section-title mt-3">{tool.name}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">{tool.summary}</p>
      <div class="mt-9 max-w-2xl">
        {
          tool.status === 'available' ? (
            <div>
              <p class="mb-5 text-sm leading-7 text-slate-600">
                {tool.id === 'ai-meta'
                  ? 'Paste your own content or enter a public URL to generate editable drafts based on real input. AI output requires human review.'
                  : 'Enter a public website URL below to run a bounded, one-resource check. Findings describe observable evidence, not guaranteed search rankings.'}
              </p>
              {tool.id === 'ai-meta' ? (
                  <AiMetaForm client:load />
                ) : (
                  <PublicToolForm kind={kind} client:load />
                )}
            </div>
          ) : (
            <StatusNotice variant="warning" title="Coming soon">
              This tool is being developed and cannot run checks yet. There is no signup or scan
              form until it is available.
            </StatusNotice>
          )
        }
      </div>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container max-w-4xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-950">
        {tool.status === 'available' ? 'What this tool checks' : 'What this tool will check'}
      </h2>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2">
        {
          tool.details.map((detail) => (
            <li class="surface-card flex items-start gap-3">
              <span class="mt-0.5 text-teal-700" aria-hidden="true">
                ✓
              </span>
              <span class="text-sm leading-7 text-slate-700">{detail}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-10">
        <a href="/tools/" class="inline-link font-semibold">← Browse all SEO tools</a>
      </div>
    </div>
  </section>
  {
    tool.status === 'available' && ['headings', 'links', 'social', 'ai-meta'].includes(tool.id) && (
      <section class="section-space bg-white" aria-labelledby="tool-faq">
        <div class="site-container max-w-4xl">
          <h2 id="tool-faq" class="text-2xl font-bold">
            Frequently asked questions
          </h2>
          {tool.id === 'headings' && (
            <div class="mt-6 space-y-5">
              <h3 class="font-semibold">Does a page have to use exactly one H1?</h3>
              <p class="text-slate-700">
                No. Multiple H1 elements can be valid HTML. Focus on a clear and readable document
                outline.
              </p>
              <h3 class="font-semibold">Are heading levels a ranking rule?</h3>
              <p class="text-slate-700">
                No fixed heading count or length guarantees rankings. The checker reports observed
                order and potential readability issues.
              </p>
            </div>
          )}
          {tool.id === 'links' && (
            <div class="mt-6 space-y-5">
              <h3 class="font-semibold">Does it check every link?</h3>
              <p class="text-slate-700">
                No. It classifies extracted anchors but tests only three same-origin destinations
                within strict budgets. External links are never fetched.
              </p>
              <h3 class="font-semibold">What does “not checked” mean?</h3>
              <p class="text-slate-700">
                It means the link has not been verified; it does not mean the URL works or is
                broken.
              </p>
            </div>
          )}
          {tool.id === 'ai-meta' && (
            <div class="mt-6 space-y-5">
              <h3 class="font-semibold">Are 30–60 title characters and 70–160 description characters mandatory?</h3>
              <p class="text-slate-700">
                No. They are approximate editorial guidelines, not display limits or ranking factors.
                Actual snippets depend on pixels, query context, and each search engine.
              </p>
              <h3 class="font-semibold">What does the generator read from a URL?</h3>
              <p class="text-slate-700">
                Only the public page's fetched title, descriptions, and headings. It cannot inspect
                private pages or JavaScript-rendered text and never performs a deep scan.
              </p>
              <h3 class="font-semibold">Can I publish AI suggestions without checking them?</h3>
              <p class="text-slate-700">
                No. Evidence is checked against the submitted text, but AI can still make
                unsupported claims. Review, edit, and confirm every factual statement.
              </p>
            </div>
          )}
          {tool.id === 'social' && (
            <div class="mt-6 space-y-5">
              <h3 class="font-semibold">Is the preview exactly what social networks show?</h3>
              <p class="text-slate-700">
                No. Platforms choose their own text, images, crops and cached data. The preview is
                an approximation based on HTML fields.
              </p>
              <h3 class="font-semibold">Does the checker download social images?</h3>
              <p class="text-slate-700">
                No. Image URLs are displayed as text; images and other resources are not fetched.
              </p>
            </div>
          )}
        </div>
      </section>
    )
  }
</SiteLayout>
