---
const enabled = import.meta.env.PUBLIC_AISEO_ANALYTICS_ENABLED === 'true';
---

<section class="rounded-xl border border-slate-200 bg-white p-5" aria-label="Analytics preferences">
  {
    enabled ? (
      <>
        <h3 class="font-bold">Optional first-party analytics</h3>
        <p class="mt-2 text-sm leading-7 text-slate-700">
          With your permission, the site can count visits to public page paths using a first-party
          endpoint. It does not place analytics cookies, send page text or create visitor profiles.
          The backend feature must also be explicitly enabled by the operator.
        </p>
        <p id="aiseo-analytics-status" class="mt-3 text-sm text-slate-700" role="status">
          No analytics preference selected.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" class="ui-button ui-button-outline" data-analytics-choice="allow">
            Allow anonymous counts
          </button>
          <button type="button" class="ui-button ui-button-outline" data-analytics-choice="deny">
            Decline or withdraw
          </button>
        </div>
      </>
    ) : (
      <>
        <h3 class="font-bold">Analytics is disabled</h3>
        <p class="mt-2 text-sm leading-7 text-slate-700">
          This build does not send first-party analytics events or load an analytics provider. No
          analytics consent storage is required while the feature is disabled.
        </p>
      </>
    )
  }
</section>

<script is:inline define:vars={{ enabled }}>
  if (enabled) {
    (() => {
      const key = 'aiseo_analytics_choice_v1';
      const status = document.getElementById('aiseo-analytics-status');
      const describe = (value) => {
        if (status) {
          status.textContent =
            value === 'allow'
              ? 'Analytics consent is enabled for this browser.'
              : value === 'deny'
                ? 'Analytics is declined for this browser.'
                : 'No analytics preference selected.';
        }
      };
      try {
        describe(window.localStorage.getItem(key));
      } catch {
        describe('deny');
      }
      document.querySelectorAll('[data-analytics-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          const value = button.getAttribute('data-analytics-choice');
          if (value !== 'allow' && value !== 'deny') return;
          try {
            window.localStorage.setItem(key, value);
          } catch {
            describe('deny');
            return;
          }
          describe(value);
          if (value === 'allow') window.dispatchEvent(new Event('aiseo:analytics-consent'));
        });
      });
    })();
  }
</script>
