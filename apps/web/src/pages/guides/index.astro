---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="SEO guides — AISEOOnline"
  description="Practical introductions to robots.txt, crawl directives and writing descriptive page titles."
>
  <section class="page-banner">
    <div class="site-container">
      <p class="eyebrow">Guides</p><h1 class="section-title mt-4">
        SEO concepts, explained without the noise.
      </h1><p class="page-intro">
        Concise introductions to checks that can be understood and verified.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container grid gap-6 md:grid-cols-2">
      <article class="surface-card">
        <span class="category-label">Technical SEO</span><h2 class="mt-4 text-xl font-bold">
          <a class="card-link" href="/guides/robots-txt-basics/"
            >Robots.txt: what it can and can't do</a
          >
        </h2><p class="mt-3 text-sm leading-7 text-slate-600">
          Crawling rules, common mistakes and why disallowing a URL doesn't automatically remove it
          from search.
        </p><a
          class="mt-6 inline-block text-sm font-semibold text-teal-800"
          href="/guides/robots-txt-basics/">Read guide ↗</a
        >
      </article>
      <article class="surface-card">
        <span class="category-label">On-page SEO</span><h2 class="mt-4 text-xl font-bold">
          <a class="card-link" href="/guides/title-tags/">Writing useful page titles</a>
        </h2><p class="mt-3 text-sm leading-7 text-slate-600">
          Making titles informative, distinctive and appropriate for each page.
        </p><a
          class="mt-6 inline-block text-sm font-semibold text-teal-800"
          href="/guides/title-tags/">Read guide ↗</a
        >
      </article>
    </div>
  </section>
</SiteLayout>
