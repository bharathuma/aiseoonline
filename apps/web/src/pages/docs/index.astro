---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Documentation — AISEOOnline"
  description="Find AISEOOnline development documentation, architecture decisions and UI component patterns."
>
  <section class="page-banner">
    <div class="site-container">
      <p class="eyebrow">Documentation</p><h1 class="section-title mt-4">
        Project documentation
      </h1><p class="page-intro">
        Technical notes and resources for exploring and contributing to the project.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container grid gap-6 md:grid-cols-2">
      <article class="surface-card">
        <h2 class="text-lg font-bold">Local development</h2><p
          class="mt-3 text-sm leading-7 text-slate-600"
        >
          Set up the web app, API and supporting services.
        </p><a
          class="mt-5 inline-block text-sm font-semibold text-teal-800"
          href="https://github.com/bharathumashankar/aiseoonline/blob/main/docs/getting-started.md"
          >Getting started ↗</a>
      </article>
      <article class="surface-card">
        <h2 class="text-lg font-bold">System architecture</h2><p
          class="mt-3 text-sm leading-7 text-slate-600"
        >
          Read about the major components and trust boundaries.
        </p><a
          class="mt-5 inline-block text-sm font-semibold text-teal-800"
          href="https://github.com/bharathumashankar/aiseoonline/blob/main/docs/architecture.md"
          >Read architecture ↗</a>
      </article>
      <article class="surface-card">
        <h2 class="text-lg font-bold">Design system</h2><p
          class="mt-3 text-sm leading-7 text-slate-600"
        >
          Review interface controls, message states and accessibility conventions.
        </p><a
          class="mt-5 inline-block text-sm font-semibold text-teal-800"
          href="/docs/components/">Component reference ↗</a>
      </article>
      <article class="surface-card">
        <h2 class="text-lg font-bold">Development roadmap</h2><p
          class="mt-3 text-sm leading-7 text-slate-600"
        >
          Review the intended sequence of capabilities.
        </p><a
          class="mt-5 inline-block text-sm font-semibold text-teal-800"
          href="https://github.com/bharathumashankar/aiseoonline/blob/main/docs/roadmap.md"
          >Read roadmap ↗</a>
      </article>
    </div>
  </section>
</SiteLayout>
