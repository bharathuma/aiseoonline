---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.tsx';
---

<SiteLayout
  title="SEO tools — AISEOOnline"
  description="Try free robots.txt, XML sitemap and metadata checkers or explore upcoming SEO utilities."
>
  <section class="page-banner">
    <div class="site-container">
      <p class="eyebrow">SEO tools</p><h1 class="section-title mt-4">
        A focused toolkit for the checks that matter.
      </h1><p class="page-intro">
        Run three free, no-signup checks or explore upcoming SEO utilities.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container"><ToolDirectory client:load /></div>
  </section>
</SiteLayout>
