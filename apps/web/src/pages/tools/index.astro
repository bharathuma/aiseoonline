---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.tsx';
---

<SiteLayout
  title="SEO tools — AISEOOnline"
  description="Browse nine working free technical SEO checkers and an optional AI meta writing tool, each with a focused guide and clear limits."
>
  <section class="page-banner">
    <div class="site-container">
      <p class="eyebrow">SEO tools</p><h1 class="section-title mt-4">
        A focused toolkit for the checks that matter.
      </h1><p class="page-intro">
        Run nine no-signup technical checks, or explore the optional AI title and description
        generator. Each page explains what it measures.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container"><ToolDirectory client:load /></div>
  </section>
</SiteLayout>
