---
import ToolDirectory from '../components/ToolDirectory.tsx';
import '../styles/global.css';
const title = 'AISEOOnline — Open-source SEO tools';
const description = 'SEO tools and site auditing, built around practical checks and clear evidence. Project in development.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://aiseoonline.com/" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <nav aria-label="Main navigation" class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5">
        <a class="text-xl font-bold tracking-tight text-slate-900" href="/">AISEO<span class="text-teal-700">Online</span></a>
        <a class="text-sm font-medium text-slate-700 underline-offset-4 hover:underline" href="https://github.com/bharathumashankar/aiseoonline" target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>
      </nav>
    </header>
    <main>
      <section class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-5 py-18 sm:py-24">
          <div class="inline-flex rounded-full bg-teal-50 px-3 py-1 text-sm font-semibold text-teal-800">Open source · Under development</div>
          <h1 class="mt-6 max-w-4xl text-4xl font-bold leading-tight tracking-tight text-slate-950 sm:text-6xl">Useful SEO tools. Clear evidence. Better decisions.</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">We're building straightforward SEO checks and site audits, with AI-assisted explanations grounded in real findings.</p>
          <a class="mt-8 inline-block rounded-xl bg-teal-700 px-6 py-3 font-semibold text-white hover:bg-teal-800" href="#tools">Explore planned tools</a>
        </div>
      </section>
      <div class="mx-auto max-w-6xl px-5 py-14 sm:py-18" id="tools">
        <ToolDirectory client:load />
      </div>
      <section class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-5 py-12">
          <h2 class="text-xl font-semibold">Built in the open</h2>
          <p class="mt-3 max-w-3xl leading-7 text-slate-600">Code, architectural notes, and updates are available on GitHub. Individual tools will be published when they're ready to use.</p>
        </div>
      </section>
    </main>
    <footer class="border-t border-slate-200 py-8">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3 px-5 text-sm text-slate-600">
        <span>© {new Date().getFullYear()} AISEOOnline</span>
        <a class="hover:underline" href="https://github.com/bharathumashankar/aiseoonline/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">Apache 2.0 license</a>
      </div>
    </footer>
  </body>
</html>
