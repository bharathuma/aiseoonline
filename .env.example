# Copy this file to .env and supply fresh random hexadecimal passwords.
# Example: python -c "import secrets; print(secrets.token_hex(24))"
# Avoid reserved URI characters in these values, or percent-encode them.
AISEO_DB_PASSWORD=
AISEO_REDIS_PASSWORD=
AISEO_API_PORT=8000
AISEO_WEB_PORT=4321

# API settings when running outside Docker (optional unless using database/worker).
AISEO_APP_NAME="AISEOOnline API"
AISEO_ENVIRONMENT=development
AISEO_LOG_LEVEL=INFO
# AISEO_DATABASE_URL=postgresql+psycopg://username:<encoded-password>@localhost:5432/aiseoonline
# AISEO_REDIS_URL=redis://:<encoded-password>@localhost:6379/0
# AISEO_OPENAI_API_KEY=
