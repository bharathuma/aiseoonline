# Copy this file to .env and supply fresh random hexadecimal passwords.
# Example: python -c "import secrets; print(secrets.token_hex(24))"
# Avoid reserved URI characters in these values, or percent-encode them.
AISEO_DB_PASSWORD=
AISEO_REDIS_PASSWORD=
AISEO_API_PORT=8000
AISEO_WEB_PORT=4321

# API settings when running outside Docker (optional unless using database/worker).
AISEO_APP_NAME="AISEOOnline API"
AISEO_ENVIRONMENT=development
AISEO_LOG_LEVEL=INFO
# AISEO_DATABASE_URL=postgresql+psycopg://username:<encoded-password>@localhost:5432/aiseoonline
# AISEO_REDIS_URL=redis://:<encoded-password>@localhost:6379/0
# AISEO_OPENAI_API_KEY=

# Optional backend-only OpenAI LLM layer. Never put keys in apps/web.
# No key is required for deterministic SEO tools or API health endpoints.
# AISEO_OPENAI_API_KEY=  # set only when intentionally enabling paid provider calls
AISEO_LLM_MODEL=gpt-4o-mini
AISEO_LLM_MAX_INPUT_TOKENS=8192
AISEO_LLM_MAX_OUTPUT_TOKENS=512
AISEO_LLM_MAX_TOTAL_TOKENS=8704
AISEO_LLM_TIMEOUT_SECONDS=15
AISEO_LLM_MAX_RETRIES=2
AISEO_LLM_CONCURRENCY=3
# Set both rates in USD per 1,000,000 tokens to estimate cost.
# Leave unset when model rates are unknown rather than inventing prices.
# AISEO_LLM_INPUT_USD_PER_MILLION=
# AISEO_LLM_OUTPUT_USD_PER_MILLION=

# Public AI generator spending allocations, required with model rate settings.
AISEO_AI_META_REQUEST_USD_CAP=0.05
AISEO_AI_META_DAILY_USD_CAP=2.00

# Private RAG ingestion (no public API or paid embedding calls by default).
AISEO_RAG_EMBEDDING_MODEL=text-embedding-3-small
AISEO_RAG_EMBEDDING_VERSION=v1

# Development-only verified-project assistant. NEVER enable on public hosting.
# AISEO_RAG_CHAT_ENABLED=false
# AISEO_RAG_CHAT_DEV_TOKEN=  # generate separately: openssl rand -hex 32
# AISEO_RAG_CHAT_DEV_OWNER_ID=  # UUID from a verified development project owner
# AISEO_RAG_CHAT_EMBEDDING_USD_PER_MILLION= # set actual embedding model rate
AISEO_RAG_CHAT_REQUEST_USD_CAP=0.10
AISEO_RAG_CHAT_DAILY_USD_CAP=1.00

# Local/private audit runner. Requires PostgreSQL, Redis, Celery worker AND beat.
# Always disabled on production, and never enables public deep scans.
AISEO_AUDIT_JOBS_ENABLED=false
# AISEO_AUDIT_DEV_TOKEN=  # random 32+ ASCII character token; never commit a real value
# AISEO_AUDIT_DEV_OWNER_ID=  # verified owner UUID from authenticated test setup
AISEO_AUDIT_DAILY_JOB_CAP=12
AISEO_AUDIT_DAILY_USD_CAP=1.00
AISEO_AUDIT_REQUEST_USD_CAP=0.30
